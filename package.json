{
  "name": "antler",
  "productName": "Antler",
  "version": "0.0.0",
  "description": "Windows / WSL / SSH 저장소를 한 화면에서 보는 가벼운 Git GUI",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "tauri": "tauri",
    "tauri:web": "vite",
    "tauri:notices": "node scripts/gen-tauri-notices.mjs",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:cdp": "tauri build --no-bundle --features cdp"
  },
  "devDependencies": {
    "@fontsource/nanum-gothic-coding": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.1",
    "png2icons": "^2.0.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "Antler"
  },
  "homepage": "https://github.com/Kang-Jacob-GitLB/antler"
}
