{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antler",
  "version": "../package.json",
  "identifier": "com.antler.app",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../out-tauri/renderer",
    "beforeDevCommand": "pnpm tauri:web",
    "beforeBuildCommand": "pnpm tauri:notices && vite build --config vite.tauri.config.mts"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com https://camo.githubusercontent.com https://user-images.githubusercontent.com https://private-user-images.githubusercontent.com https://github.com https://github.githubassets.com; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Antler",
    "category": "DeveloperTool",
    "shortDescription": "Windows / WSL / SSH 저장소를 한 화면에서 보는 가벼운 Git GUI",
    "resources": {
      "gen/licenses/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../resources/licenses/Pretendard-LICENSE.txt": "licenses/Pretendard-LICENSE.txt",
      "../resources/licenses/NanumGothicCoding-LICENSE.txt": "licenses/NanumGothicCoding-LICENSE.txt"
    },
    "icon": ["../resources/icon.ico", "../resources/icon.png", "../resources/icon.icns"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": { "signingIdentity": "-", "hardenedRuntime": false },
    "linux": { "deb": { "recommends": ["git"] } }
  }
}
