{
  "_comment": "git:fetch 채널 시나리오. TS(FetchService)와 Rust(라우터+FetchService)가 같은 순서로 돌려 같은 상태 결과를 내는지 본다(tests/golden/channels/fetch.json). 저장소 쌍: origin(basic.fi) 와 그 복제본 repo(경로 URL — file 전송). step: {in:'origin'|'repo', git:[...]} 는 git 실행, {fetch:{manual, confirm?, during?}} 는 git:fetch. confirm 은 확인 창에서 누른 버튼 번호(null 은 창 실패)이고 기본은 2(취소). during 은 확인 창이 떠 있는 동안 실행하는 git 단계(검사와 실행 사이의 설정 변경). 인자의 {port} 는 시나리오의 401 서버 포트로 바뀐다(server:'auth401').",
  "scenarios": [
    {
      "name": "수동 fetch: 새 커밋을 받으면 변경을 알리고 승인을 남긴다",
      "steps": [
        { "in": "origin", "git": ["commit", "-q", "--allow-empty", "-m", "second"] },
        { "fetch": { "manual": true } },
        { "fetch": { "manual": true } }
      ]
    },
    {
      "name": "자동 fetch 는 file 전송 remote 를 받지 않고 멈춘다",
      "steps": [{ "fetch": { "manual": false } }]
    },
    {
      "name": "수동 fetch 로 승인된 remote 라도 자동 fetch 는 file 전송을 받지 않는다",
      "steps": [
        { "fetch": { "manual": true } },
        { "in": "origin", "git": ["commit", "-q", "--allow-empty", "-m", "second"] },
        { "fetch": { "manual": false } },
        { "fetch": { "manual": true } }
      ]
    },
    {
      "name": "manual 이 true 가 아니면(문자열) 자동 fetch 다",
      "steps": [{ "fetch": { "manual": "true" } }, { "fetch": { "manual": 1 } }, { "fetch": {} }]
    },
    {
      "name": "remote 가 없으면 noRemote",
      "steps": [{ "in": "repo", "git": ["remote", "remove", "origin"] }, { "fetch": { "manual": true } }]
    },
    {
      "name": "위험 설정: 자동 fetch 는 묻지 않고 차단한다",
      "steps": [{ "in": "repo", "git": ["config", "core.sshCommand", "false"] }, { "fetch": { "manual": false, "confirm": 0 } }]
    },
    {
      "name": "위험 설정: 취소·닫기·창 실패·범위 밖 응답은 모두 차단한다",
      "steps": [
        { "in": "repo", "git": ["config", "core.sshCommand", "false"] },
        { "fetch": { "manual": true, "confirm": 2 } },
        { "fetch": { "manual": true, "confirm": null } },
        { "fetch": { "manual": true, "confirm": 99 } },
        { "fetch": { "manual": true, "confirm": -1 } }
      ]
    },
    {
      "name": "위험 설정: 이번만 허용은 이번 실행에만 유효하다(다음 수동 fetch 는 다시 묻는다)",
      "steps": [
        { "in": "repo", "git": ["config", "core.sshCommand", "false"] },
        { "fetch": { "manual": true, "confirm": 0 } },
        { "fetch": { "manual": true, "confirm": 2 } }
      ]
    },
    {
      "name": "위험 설정: 항상 허용은 같은 설정이 유지되는 동안 다시 묻지 않고 바뀌면 다시 묻는다",
      "steps": [
        { "in": "repo", "git": ["config", "core.sshCommand", "false"] },
        { "fetch": { "manual": true, "confirm": 1 } },
        { "fetch": { "manual": true, "confirm": 2 } },
        { "in": "repo", "git": ["config", "core.sshCommand", "true"] },
        { "fetch": { "manual": true, "confirm": 2 } }
      ]
    },
    {
      "name": "위험 설정: 확인 중에 설정이 바뀌면 허용과 무관하게 멈춘다(TOCTOU)",
      "steps": [
        { "in": "repo", "git": ["config", "core.sshCommand", "false"] },
        { "fetch": { "manual": true, "confirm": 0, "during": { "in": "repo", "git": ["config", "core.sshCommand", "true"] } } }
      ]
    },
    {
      "name": "remote URL: UNC·ext:: 는 확인 없이 거부한다",
      "steps": [
        { "in": "repo", "git": ["remote", "set-url", "origin", "//127.0.0.1/share/r"] },
        { "fetch": { "manual": true, "confirm": 0 } },
        { "in": "repo", "git": ["remote", "set-url", "origin", "ext::sh -c true"] },
        { "fetch": { "manual": true, "confirm": 0 } }
      ]
    },
    {
      "name": "remote URL: 확인 중에 ext:: 로 바뀌면 허용과 무관하게 거부한다",
      "steps": [
        { "in": "repo", "git": ["config", "core.sshCommand", "false"] },
        { "fetch": { "manual": true, "confirm": 0, "during": { "in": "repo", "git": ["remote", "set-url", "origin", "ext::sh -c true"] } } }
      ]
    },
    {
      "name": "인증 실패: 자동은 수동 확인을 요구하며 멈추고, 수동은 멈추기만 한다",
      "server": "auth401",
      "steps": [
        { "in": "repo", "git": ["remote", "set-url", "origin", "http://127.0.0.1:{port}/r.git"] },
        { "fetch": { "manual": false } },
        { "fetch": { "manual": true } }
      ]
    }
  ]
}
