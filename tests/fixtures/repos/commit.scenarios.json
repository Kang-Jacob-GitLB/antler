{
  "_": "git:commit 채널 패리티 시나리오. TS(tests/goldenChannels.test.ts)와 Rust(src-tauri/tests/channels.rs)가 같은 목록을 돈다. repo 는 같은 폴더의 <repo>.fi, rev 는 import 한 저장소에서 git rev-parse 로 푼 해시, hash 는 그대로 보내는 값(문자열이 아니어도 된다), upper 는 대문자로, short 는 앞 N 글자만 쓴다(그 뒤에 prefix·suffix 문자열을 붙인다).",
  "scenarios": [
    { "name": "루트 커밋", "repo": "basic", "rev": "main~4" },
    { "name": "수정·추가·삭제·이름 변경·바이너리·한글 경로", "repo": "basic", "rev": "main~3" },
    { "name": "병합 커밋(첫 부모 대비)", "repo": "basic", "rev": "main~2" },
    { "name": "가지의 커밋", "repo": "basic", "rev": "feature" },
    { "name": "빈 커밋(변경 파일 없음)", "repo": "basic", "rev": "main~1" },
    { "name": "본문이 공백뿐인 커밋", "repo": "basic", "rev": "main" },
    { "name": "대문자 해시", "repo": "basic", "rev": "main~3", "upper": true },
    { "name": "7글자 약식 해시", "repo": "basic", "rev": "main~3", "short": 7 },
    { "name": "상한을 넘는 변경 파일(truncated)", "repo": "many", "rev": "main" },
    { "name": "없는 해시는 GIT 오류", "repo": "basic", "hash": "0000000000000000000000000000000000000000" },
    { "name": "해시가 아닌 값 zzzz", "repo": "basic", "hash": "zzzz" },
    { "name": "너무 짧은 해시", "repo": "basic", "hash": "abc" },
    { "name": "너무 긴 해시", "repo": "basic", "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    { "name": "옵션처럼 보이는 -x", "repo": "basic", "hash": "-x" },
    { "name": "옵션 --output", "repo": "basic", "hash": "--output=pwned.txt" },
    { "name": "옵션 -c alias", "repo": "basic", "hash": "-calias.x=!echo" },
    { "name": "HEAD 같은 이름", "repo": "basic", "hash": "HEAD" },
    { "name": "해시 뒤 개행", "repo": "basic", "rev": "main", "suffix": "\n" },
    { "name": "해시 앞 공백", "repo": "basic", "rev": "main", "prefix": " " },
    { "name": "숫자", "repo": "basic", "hash": 123 },
    { "name": "null", "repo": "basic", "hash": null }
  ]
}
