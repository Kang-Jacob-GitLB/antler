  "steps": [
    { "name": "미연결 상태", "ch": "jira:auth", "args": [] },
    { "name": "미연결에서 이슈 조회", "ch": "jira:issue", "args": ["ABC-1"] },
    { "name": "미연결에서 전환 목록", "ch": "jira:transitions", "args": ["ABC-1", "req-x"] },
    { "name": "미연결에서 사진", "ch": "jira:avatar", "args": ["{base}/secure/avatar.png"] },

    { "name": "연결 입력이 없다", "ch": "jira:connect", "args": [] },
    { "name": "연결 입력의 종류가 틀렸다", "ch": "jira:connect", "args": [{ "kind": "x", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }] },
    { "name": "http 평문(루프백이 아닌 호스트)", "ch": "jira:connect", "args": [{ "kind": "cloud", "siteUrl": "http://example.com", "email": "a@b.c", "token": "tok_SECRET_0123456789" }] },
    { "name": "토큰에 공백", "ch": "jira:connect", "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok SECRET" }] },
    { "name": "이메일에 콜론", "ch": "jira:connect", "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a:b@c.d", "token": "tok_SECRET_0123456789" }] },
    {
      "name": "연결 401",
      "ch": "jira:connect",
      "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }],
      "routes": [{ "method": "GET", "path": "/rest/api/3/myself", "responses": [{ "status": 401, "body": { "message": "bad" } }] }]
    },
    {
      "name": "연결 403",
      "ch": "jira:connect",
      "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }],
      "routes": [{ "method": "GET", "path": "/rest/api/3/myself", "responses": [{ "status": 403, "body": { "errorMessages": ["no"] } }] }]
    },
    {
      "name": "연결 404",
      "ch": "jira:connect",
      "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }],
      "routes": [{ "method": "GET", "path": "/rest/api/3/myself", "responses": [{ "status": 404 }] }]
    },
    {
      "name": "연결 429(오래 기다려야 한다)",
      "ch": "jira:connect",
      "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }],
      "routes": [{ "method": "GET", "path": "/rest/api/3/myself", "responses": [{ "status": 429, "headers": { "Retry-After": "60" }, "body": { "message": "slow" } }] }]
    },
    {
      "name": "연결 리다이렉트",
      "ch": "jira:connect",
      "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }],
      "routes": [{ "method": "GET", "path": "/rest/api/3/myself", "responses": [{ "status": 302, "headers": { "Location": "https://evil.example/" } }] }]
    },
    {
      "name": "연결 500",
      "ch": "jira:connect",
      "args": [{ "kind": "cloud", "siteUrl": "{base}", "email": "a@b.c", "token": "tok_SECRET_0123456789" }],
      "routes": [{ "method": "GET", "path": "/rest/api/3/myself", "responses": [{ "status": 500, "body": { "errorMessages": ["boom"] } }] }]
    },
